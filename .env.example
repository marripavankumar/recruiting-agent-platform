# Copy to .env for local development. Never commit .env.
RAP_ENVIRONMENT=local
RAP_DATABASE_URL=postgresql://rap:rap@localhost:5432/rap
RAP_QDRANT_URL=http://localhost:6333

# memory (no database) | postgres
RAP_STORAGE=postgres

# dev (local only, X-Dev-User-Email header) | oidc (any OpenID Connect provider)
RAP_AUTH_PROVIDER=dev
# RAP_OIDC_ISSUER=
# RAP_OIDC_AUDIENCE=
# RAP_OIDC_JWKS_URL=

# Cloud plug-and-play: environment | azure_key_vault | aws_secrets_manager | gcp_secret_manager | hashicorp_vault
RAP_SECRETS_PROVIDER=environment

# claude (Anthropic API: ANTHROPIC_API_KEY or `ant auth login`) | none (rule-based fallbacks)
RAP_LLM_PROVIDER=claude
RAP_LLM_MODEL=claude-opus-5-5
RAP_RESUME_PARSER=affinda
# JSON lists. Options: ["m365", "gmail"] and ["sharepoint", "onedrive", "s3"]
RAP_EMAIL_PROVIDERS=[]
# Mailbox approved emails are sent from; token in RAP_SECRET_M365_ACCESS_TOKEN or RAP_SECRET_GMAIL_ACCESS_TOKEN
# RAP_EMAIL_SENDER=bd@cbs.example
RAP_DOCUMENT_STORES=[]

RAP_OUTREACH_ENABLED=false
# Test environment only: send only to these internal addresses, e.g. ["qa@cbs.example"]
RAP_OUTREACH_ALLOW_LIST=[]
RAP_OUTREACH_DAILY_CAP_EMAIL=100

# Commercial email compliance (CAN-SPAM / CASL): sender identity, postal address, unsubscribe
RAP_PUBLIC_BASE_URL=http://localhost:8000
RAP_UNSUBSCRIBE_SECRET=local-dev-unsubscribe-secret
RAP_OUTREACH_SENDER_NAME=CBS LLC Business Development
RAP_OUTREACH_POSTAL_ADDRESS=CBS LLC, postal address to be configured
RAP_CLIENT_OUTREACH_MIN_PRIORITY=70
# Shared secret the mail-routing workflow (n8n) sends to POST /inbound/email
# RAP_INBOUND_WEBHOOK_SECRET=

# memory | qdrant (at RAP_QDRANT_URL)
RAP_VECTOR_STORE=memory
# Local in-memory runs only: one demo user per staff role
# RAP_DEMO_USERS=true
# Also load a fictional pipeline to click through in the web app (local, in-memory only;
# emails go to an in-memory outbox, career pages are canned, no LLM calls).
# RAP_DEMO_DATA=true
# Run follow-ups, delivery retries and career-page re-checks inside the API (in-memory runs).
# Deployments run "python -m recruiting.scheduler" as its own process instead.
# RAP_RUN_SCHEDULER=true
# Deep agents (LangGraph + deepagents) drive the workflow; needs RAP_LLM_PROVIDER=claude
# RAP_AGENTS_ENABLED=true
# RAP_AGENT_EFFORT=high
# RAP_AGENT_DAILY_RUN_LIMIT=200
# Read replies, JDs and bounce reports from the outreach mailbox every 2 minutes
# (needs gmail.modify or Mail.ReadWrite on the mailbox token)
# RAP_READ_MAILBOX=true
# RAP_INBOUND_MAILBOX=bd@cbs.example

# Agent 11 client package attached to submission emails: pdf | docx | none
RAP_SUBMISSION_ATTACHMENT=pdf
RAP_BRAND_NAME=CBS LLC
RAP_BRAND_COLOR=#1F3A93
# RAP_BRAND_LOGO_PATH=/path/to/logo.png

# Secrets for the "environment" provider (local and dev only)
# RAP_SECRET_ANTHROPIC_API_KEY=
# RAP_SECRET_AFFINDA_API_KEY=
